# ---- IDA Pro database / work files ----
*.idb
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
*.$$$
*.dmp

# ---- runtime logs (kept locally, not in the repo) ----
logs/*
!logs/.gitkeep
*.log

# ---- pe_dumper.py / save_region output (written next to the sample) ----
*_dumped_*.exe
*_dumped_*.dll
*_dumped_*.sys
*_dumped_*.bin
*_blob_*.bin

# ---- loader stubs generated by dll_loader_stub_generator.py ----
*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].exe

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- OS / editor cruft ----
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
